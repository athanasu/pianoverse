# Copy to .env.local (gitignored) to use the backend; leave VITE_API_URL empty for the offline demo.
# Server base URL without /api, e.g. the local `uv run pianoverse-server` from engine/.
VITE_API_URL=http://127.0.0.1:8000
# Must equal the server's PIANOVERSE_API_KEY. It ends up in the web bundle: fine for a personal tool only.
VITE_API_KEY=
